[Unit]
Description=Simple MCP ImageMagick Server
After=network.target

[Service]
Type=simple
User=simple-mcp
Group=simple-mcp
ExecStart=/usr/bin/simple-mcp --config /etc/simple-mcp/simple-mcp.yaml

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Only allow writing to the media dir and scratch space
ReadWritePaths=/srv/media /var/lib/simple-mcp/scratch

[Install]
WantedBy=multi-user.target
